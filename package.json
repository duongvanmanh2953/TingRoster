{
  "name": "tingroster",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:landing": "next dev -p 3000",
    "dev:admin": "PORT=4000 next dev -p 4000",
    "dev:owner": "PORT=4001 next dev -p 4001",
    "dev:member": "PORT=4002 next dev -p 4002",
    "dev:kiosk": "PORT=4003 next dev -p 4003",
    "dev:api": "PORT=4100 next dev -p 4100",
    "build": "prisma generate && node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:clean": "tsx scripts/safe-db-reset.ts --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@gsap/react": "^2.1.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@prisma/client": "^5.21.1",
    "@tanstack/react-query": "^5.59.16",
    "@types/aos": "^3.0.8",
    "aos": "^2.3.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "docx": "^9.15.0",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
