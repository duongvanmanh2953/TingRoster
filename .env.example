# ==============================================================================
# TingRoster Environment Configuration Template
# Copy this file to .env and replace placeholders with production secrets
# ==============================================================================

# 1. Database Connection (PostgreSQL 16)
# Local Docker development uses port 5433 (host) -> 5432 (container)
DATABASE_URL="postgresql://tingroster:tingroster_secret_password@localhost:5433/tingroster?schema=public"

# 2. Authentication & JWT Security (Minimum 32 random characters)
JWT_SECRET="generate_a_random_secure_secret_with_openssl_rand_hex_32"

# 3. Application URLs & Domain Mapping
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:4000"
NEXT_PUBLIC_OWNER_URL="http://localhost:4001"
NEXT_PUBLIC_MEMBER_URL="http://localhost:4002"
NEXT_PUBLIC_KIOSK_URL="http://localhost:4003"
NEXT_PUBLIC_API_URL="http://localhost:4100"

# 4. Email Service (SMTP / Mailpit / SES / SendGrid)
# For local development with Mailpit: SMTP_HOST="localhost", SMTP_PORT=1025
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey_or_username"
SMTP_PASS="secret_password"
SMTP_SECURE="false"
SMTP_FROM="TingRoster <no-reply@tingroster.vn>"

# 5. VietQR Default Bank Configuration (Configurable per facility)
DEFAULT_BANK_ID="MB"
DEFAULT_BANK_ACCOUNT_NO="0987654321"
DEFAULT_BANK_ACCOUNT_NAME="NGUYEN VAN A"

# 6. Payment Webhook Verification Keys
SEPAY_WEBHOOK_API_KEY="sepay_webhook_api_key_secret"
CASSO_WEBHOOK_SECURE_TOKEN="casso_webhook_secure_token"

# 7. Operational Notifications (Optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
