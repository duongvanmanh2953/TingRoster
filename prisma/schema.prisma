generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum GroupType {
  CLASS
  SPORTS_CLUB
  RENTAL
  GENERAL
}

enum BillingCycle {
  DAILY
  MONTHLY
  PER_SESSION
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT_CHARGED
  ABSENT_EXCUSED
  MAKEUP
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  OVERPAID
  VOID
}

enum TransactionDirection {
  IN
  OUT
}

enum ProcessingStatus {
  UNMATCHED
  MATCHED
  PROCESSED
  DUPLICATE
  IGNORED
  FAILED
}

enum ProviderType {
  SEPAY
  CASSO
  MANUAL
}

enum NotificationChannel {
  TELEGRAM
  ZALO
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum Role {
  USER
  ADMIN
}

enum LedgerType {
  TOPUP
  USAGE_WEBHOOK
  USAGE_NOTIFICATION
  USAGE_AI_OCR
  REFUND
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  name            String
  passwordHash    String
  role            Role           @default(USER)
  serviceBalance  Int            @default(100000) // VND integer
  bankId          String         @default("MB")
  bankAccountNo   String         @default("0987654321")
  bankAccountName String         @default("NGUYEN VAN A")
  logoUrl         String?        // Custom workspace brand logo
  avatarUrl       String?        // Custom owner avatar
  planType        PlanType       @default(FREE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  groups          Group[]
  invoices        Invoice[]
  transactionLogs TransactionLog[]
  providerConfigs PaymentProviderConfig[]
  notificationLogs NotificationLog[]
  auditLogs       AuditLog[]
  automationRules AutomationRule[]
  walletLedgers   WalletLedgerEntry[]
  aiImportJobs    AiImportJob[]
  memberProfiles  Member[]          @relation("UserMemberProfiles")
  supportTickets  SupportTicket[]
  joinRequests    SpaceJoinRequest[]
  shiftAssignments ShiftAssignment[]
  claimedTemporaryAccounts TemporaryAccount[] @relation("ClaimedUser")

  @@index([email])
  @@index([role])
  @@index([name])
}

model Group {
  id                  String       @id @default(cuid())
  userId              String
  name                String
  slug                String       @unique
  code                String?      @unique // Unique space identifier e.g. TR-8921
  description         String?
  logoUrl             String?      // Custom group/space logo
  themeColor          String?      @default("#2538D9") // Custom space accent color
  enabledModules      String?      @default("members,attendance,invoices,reports") // Comma-separated list of enabled modules
  defaultFee          Int          @default(0) // VND integer
  billingCycle        BillingCycle @default(MONTHLY)
  groupType           GroupType    @default(GENERAL)
  isActive            Boolean      @default(true)
  publicPortalEnabled Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  members            Member[]
  attendances        Attendance[]
  invoices           Invoice[]
  services           Service[]
  meterReadings      MeterReading[]
  sportsBookings     SportsBooking[]
  rentalContracts    RentalContract[]
  educationalClasses EducationalClass[]
  actionQrCodes      ActionQrCode[]
  joinRequests       SpaceJoinRequest[]
  workShifts         WorkShift[]
  shiftAssignments   ShiftAssignment[]
  conversations      Conversation[]
  temporaryAccounts  TemporaryAccount[]
  digitalContracts   DigitalContract[]
  spaceClauses       SpaceClause[]
  pricingHistories   PricingHistory[]
  ocrJobs            DocumentOcrJob[]
  surcharges         SurchargeProposal[]

  @@index([userId])
  @@index([slug])
  @@index([code])
}

model Member {
  id         String       @id @default(cuid())
  groupId    String
  userId     String?
  name       String
  phone      String?
  parentName String?
  gender     String?      @default("OTHER")
  ageGroup   String?      @default("TEEN")
  avatarUrl  String?
  status     MemberStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  group              Group                          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user               User?                          @relation("UserMemberProfiles", fields: [userId], references: [id], onDelete: SetNull)
  attendances        Attendance[]
  invoices           Invoice[]
  adjustmentRequests AttendanceAdjustmentRequest[]
  meterReadings      MeterReading[]
  sportsBookings     SportsBooking[]
  rentalContracts    RentalContract[]
  surcharges         SurchargeProposal[]

  @@index([groupId])
  @@index([userId])
  @@index([name])
  @@index([phone])
}

model Attendance {
  id        String           @id @default(cuid())
  groupId   String
  memberId  String
  date      DateTime         @db.Date
  isPresent Boolean          @default(true)
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId, date])
  @@index([groupId, date])
  @@index([memberId])
}

model Invoice {
  id                 String        @id @default(cuid())
  memberId           String
  groupId            String
  userId             String
  title              String
  amountDue          Int // VND integer
  amountPaid         Int           @default(0) // VND integer
  paymentCode        String        @unique // e.g. TR84920
  publicToken        String        @unique @default(cuid()) // Opaque secure token for public URL
  status             InvoiceStatus @default(UNPAID)
  dueDate            DateTime?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  sessionCount       Int?          @default(0)
  feePerSession      Int?          @default(0)
  paidAt             DateTime?
  metadata           String?       // JSON metadata
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  member              Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group               Group               @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations         PaymentAllocation[]
  matchedTransactions TransactionLog[]
  lineItems           InvoiceLineItem[]

  @@index([userId])
  @@index([groupId])
  @@index([memberId])
  @@index([paymentCode])
  @@index([publicToken])
  @@index([status])
}

model TransactionLog {
  id                    String               @id @default(cuid())
  userId                String?
  provider              ProviderType
  providerTransactionId String
  rawPayload            String // Safe JSON string
  matchedInvoiceId      String?
  amount                Int // VND integer
  content               String
  direction             TransactionDirection @default(IN)
  transactionDate       DateTime
  processingStatus      ProcessingStatus     @default(UNMATCHED)
  failureReason         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  matchedInvoice Invoice?            @relation(fields: [matchedInvoiceId], references: [id], onDelete: SetNull)
  allocations    PaymentAllocation[]

  @@unique([provider, providerTransactionId])
  @@index([userId])
  @@index([matchedInvoiceId])
  @@index([processingStatus])
  @@index([transactionDate])
}

model PaymentAllocation {
  id               String         @id @default(cuid())
  transactionLogId String
  invoiceId        String
  amount           Int // VND integer
  createdAt        DateTime       @default(now())

  transactionLog TransactionLog @relation(fields: [transactionLogId], references: [id], onDelete: Cascade)
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([transactionLogId])
  @@index([invoiceId])
}

model PaymentProviderConfig {
  id            String       @id @default(cuid())
  userId        String
  provider      ProviderType
  apiKey        String
  webhookSecret String
  accountNumber String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model NotificationLog {
  id              String              @id @default(cuid())
  userId          String
  invoiceId       String?
  channel         NotificationChannel @default(TELEGRAM)
  recipient       String
  message         String
  status          NotificationStatus  @default(PENDING)
  responsePayload String?
  createdAt       DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  details    String?  // JSON formatted details
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model OutboxEvent {
  id          String       @id @default(cuid())
  eventType   String       // e.g. PAYMENT_RECEIVED, INVOICE_PAID
  payload     String       // JSON string
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([status])
  @@index([createdAt])
}

model AutomationRule {
  id            String   @id @default(cuid())
  userId        String
  name          String
  trigger       String   // ON_PAYMENT_DUE, ON_UNMATCHED_TRANSACTION, ON_DAILY_SUMMARY, ON_INVOICE_PAID
  action        String   // TELEGRAM_ALERT, EMAIL_SUMMARY, AUTO_REMINDER
  isEnabled     Boolean  @default(true)
  lastRunAt     DateTime?
  lastRunStatus String?  // SUCCESS, FAILED
  config        String?  // JSON configuration
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletLedgerEntry {
  id           String     @id @default(cuid())
  userId       String
  amount       Int        // Positive for credit/topup, negative for debit/usage
  balanceAfter Int        // Snapshot of balance after this entry
  type         LedgerType
  description  String
  referenceId  String?    // e.g. transaction code, invoice id, batch id
  metadata     String?    // JSON extra payload
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

model AiImportJob {
  id              String   @id @default(cuid())
  userId          String
  fileName        String
  fileType        String   // IMAGE, EXCEL, CSV
  extractedCount  Int      @default(0)
  confidenceScore Int      @default(95) // 0 - 100
  rawResult       String   // Safe JSON representation of parsed roster
  targetGroupId   String?
  status          String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AttendanceAdjustmentRequest {
  id              String           @id @default(cuid())
  memberId        String
  attendanceId    String?
  groupId         String
  date            DateTime         @db.Date
  requestedStatus AttendanceStatus @default(PRESENT)
  reason          String
  status          String           @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy      String?
  reviewNote      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([groupId])
  @@index([status])
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketCode  String   @unique // e.g. TK-83921
  userId      String
  category    String   // BUG, FEATURE, BILLING, GENERAL
  subject     String
  description String
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticketCode])
  @@index([status])
}

model Conversation {
  id               String        @id @default(cuid())
  groupId          String?
  type             String        @default("GROUP") // ANNOUNCEMENT, GROUP, DIRECT
  title            String
  workspaceId      String        // Owner user ID
  onlyAdminCanPost Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  messages         ChatMessage[]
  polls            GroupPoll[]

  group            Group?        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([groupId])
  @@index([type])
}

model ChatMessage {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String              // User ID or Member ID
  senderName     String
  senderRole     String              // OWNER, MANAGER, MEMBER, ADMIN, SYSTEM
  content        String
  messageType    String              @default("TEXT") // TEXT, SYSTEM, CARD_SCHEDULE, CARD_ATTENDANCE, CARD_POLL, CARD_ANNOUNCEMENT, CARD_PAYMENT, CARD_FILE
  isAnnouncement Boolean             @default(false)
  replyToId      String?
  isEdited       Boolean             @default(false)
  editedAt       DateTime?
  isDeleted      Boolean             @default(false)
  isPinned       Boolean             @default(false)
  pinnedAt       DateTime?
  pinnedById     String?
  pinnedByName   String?
  cardPayload    String?             // JSON string for business cards (schedule, attendance, poll, etc.)
  createdAt      DateTime            @default(now())

  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo        ChatMessage?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ChatMessage[]       @relation("MessageReplies")
  attachments    MessageAttachment[]
  reactions      MessageReaction[]

  @@index([conversationId])
  @@index([createdAt])
  @@index([replyToId])
  @@index([isPinned])
}

model MessageAttachment {
  id        String      @id @default(cuid())
  messageId String
  fileName  String
  fileUrl   String
  fileType  String      // e.g. image/jpeg, application/pdf
  fileSize  Int         // bytes
  createdAt DateTime    @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  userName  String
  emoji     String      // "👍", "❤️", "🎉", "🔥", "😂"
  createdAt DateTime    @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model GroupPoll {
  id             String       @id @default(cuid())
  conversationId String
  messageId      String?      @unique
  creatorId      String
  creatorName    String
  question       String
  isMultiple     Boolean      @default(false)
  isClosed       Boolean      @default(false)
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  options        PollOption[]
  votes          PollVote[]

  @@index([conversationId])
}

model PollOption {
  id        String     @id @default(cuid())
  pollId    String
  text      String
  createdAt DateTime   @default(now())

  poll      GroupPoll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  userName  String
  createdAt DateTime   @default(now())

  poll      GroupPoll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([pollId, optionId, userId])
  @@index([pollId])
  @@index([userId])
}

model GroupReadState {
  id                String   @id @default(cuid())
  groupId           String
  userId            String
  lastReadMessageId String?
  lastReadAt        DateTime @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model PolicyDocument {
  id            String             @id @default(cuid())
  policyType    String             @unique // TERMS, PRIVACY, REFUND, COMMUNITY
  title         String
  version       String             // e.g. 2.4
  summary       String
  content       String             // Markdown text
  publishedAt   DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  acceptances   PolicyAcceptance[]
}

model PolicyAcceptance {
  id         String   @id @default(cuid())
  userId     String
  policyId   String
  version    String
  ipAddress  String?
  acceptedAt DateTime @default(now())

  policy PolicyDocument @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([userId, policyId, version])
  @@index([userId])
}

model Service {
  id          String   @id @default(cuid())
  groupId     String
  name        String
  code        String   // e.g. SVC-ELEC, SVC-COURT-01
  category    String   @default("GENERAL") // RENTAL, SPORTS, EDUCATION, UTILITY, GENERAL
  billingType String   @default("MONTHLY") // FIXED_ONE_TIME, DAILY, WEEKLY, MONTHLY, PER_SESSION, PER_HOUR, METERED, PACKAGE, SURCHARGE
  unit        String   @default("tháng") // kWh, m3, giờ, buổi, tháng, người
  unitPrice   Int      @default(0) // VND integer
  description String?
  isActive    Boolean  @default(true)
  metadata    String?  // JSON configuration: tiered pricing, peak hours, rules
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lineItems   InvoiceLineItem[]

  @@unique([groupId, code])
  @@index([groupId])
  @@index([category])
  @@index([isActive])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  serviceId   String?
  title       String
  unit        String?
  quantity    Float    @default(1)
  unitPrice   Int      // Snapshot VND
  amount      Int      // Snapshot total = quantity * unitPrice
  metadata    String?  // JSON details e.g. previousReading, currentReading, courtTime
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceId])
}

model MeterReading {
  id            String   @id @default(cuid())
  groupId       String
  memberId      String?
  roomCode      String   // e.g. P.101, P.202
  billingMonth  String   // "2026-10"
  prevElectric  Float    @default(0)
  currElectric  Float    @default(0)
  electricUsage Float    @default(0)
  electricRate  Int      @default(3500)
  electricTotal Int      @default(0)
  prevWater     Float    @default(0)
  currWater     Float    @default(0)
  waterUsage    Float    @default(0)
  waterRate     Int      @default(25000)
  waterTotal    Int      @default(0)
  meterImageUrl String?
  note          String?
  status        String   @default("PENDING") // PENDING, INVOICED
  invoiceId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member        Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@unique([groupId, roomCode, billingMonth])
  @@index([groupId])
  @@index([memberId])
  @@index([billingMonth])
}

model SportsBooking {
  id             String    @id @default(cuid())
  groupId        String
  memberId       String?
  customerName   String
  customerPhone  String?
  courtName      String    // Sân Pickleball 1
  courtType      String    @default("STANDARD") // INDOOR, OUTDOOR, VIP
  bookingDate    DateTime  @db.Date
  startTime      String    // "18:00"
  endTime        String    // "20:00"
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  status         String    @default("RESERVED") // RESERVED, CHECKED_IN, CHECKED_OUT, CANCELLED, NO_SHOW
  courtPrice     Int       @default(0)
  overtimeFee    Int       @default(0)
  surchargeFee   Int       @default(0)
  totalAmount    Int       @default(0)
  paidAmount     Int       @default(0)
  isPaid         Boolean   @default(false)
  invoiceId      String?
  qrToken        String    @unique @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member         Member?   @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([memberId])
  @@index([bookingDate])
  @@index([status])
  @@index([qrToken])
}

model RentalContract {
  id                String    @id @default(cuid())
  groupId           String
  memberId          String
  roomNumber        String    // e.g. "P.202"
  contractCode      String    @unique // e.g. "HD-202-01"
  monthlyRent       Int       // VND
  depositAmount     Int       @default(0)
  startDate         DateTime  @db.Date
  endDate           DateTime? @db.Date
  billingDayOfMonth Int       @default(5)
  status            String    @default("ACTIVE") // ACTIVE, EXPIRING_SOON, TERMINATED
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  group             Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member            Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([memberId])
  @@index([roomNumber])
  @@index([status])
}

model EducationalClass {
  id            String   @id @default(cuid())
  groupId       String
  className     String   // e.g. "Lớp Toán 9A"
  subject       String   // e.g. "Toán học"
  courseType    String   @default("MONTHLY") // MONTHLY, PACKAGE, PER_SESSION
  teacherName   String?
  room          String?
  schedule      String?  // "T3, T5: 18:00 - 19:30"
  maxCapacity   Int      @default(30)
  feePerPeriod  Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([className])
  @@index([status])
}

model ActionQrCode {
  id          String   @id @default(cuid())
  token       String   @unique // Cryptographic opaque token e.g. "tr_act_ckx982..."
  shortCode   String   @unique // 6-8 char code for manual fallback e.g. "ACT-8921"
  actionType  String   // ATTENDANCE, JOIN_SPACE, JOIN_GROUP, PAYMENT, SHIFT_REGISTER, SHIFT_CHECK_IN, SHIFT_CHECK_OUT, BOOKING, EVENT_REGISTER
  groupId     String
  contextType String?  // CLASS, SESSION, INVOICE, BOOKING, SHIFT, GENERAL
  contextId   String?  // Reference ID of specific context
  title       String
  description String?
  metadata    String?  // JSON string
  expiresAt   DateTime
  isRevoked   Boolean  @default(false)
  usageCount  Int      @default(0)
  maxUsage    Int?     // null = unlimited usage
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([actionType])
  @@index([token])
  @@index([shortCode])
  @@index([expiresAt])
}

model SpaceJoinRequest {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  userName    String
  userEmail   String?
  userPhone   String?
  message     String?
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([status])
}

model WorkShift {
  id          String            @id @default(cuid())
  groupId     String
  name        String            // e.g. "Ca sáng Lễ tân & Huấn luyện viên"
  shiftDate   DateTime          @db.Date
  startTime   String            // "08:00"
  endTime     String            // "12:00"
  location    String?
  maxSlots    Int               @default(2)
  status      String            @default("OPEN") // OPEN, CLOSED, CANCELLED
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@index([groupId])
  @@index([shiftDate])
  @@index([status])
}

model ShiftAssignment {
  id             String    @id @default(cuid())
  shiftId        String
  groupId        String
  userId         String
  userName       String
  status         String    @default("APPROVED") // PENDING, APPROVED, REJECTED, CANCELLED
  checkInTime    DateTime?
  checkOutTime   DateTime?
  checkInSource  String?   // KIOSK, MOBILE_QR, MANUAL
  checkOutSource String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  shift          WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
}

model TemporaryAccount {
  id             String    @id @default(cuid())
  identifier     String    @unique // e.g. "TR-TEMP-948210"
  name           String
  phone          String?
  email          String?
  groupId        String
  ownerId        String
  status         String    @default("CREATED") // CREATED, PENDING_ACTIVATION, ACTIVE_TEMPORARY, CLAIMED, EXPIRED, REVOKED, DISABLED
  activationCode String    @unique // 6-digit code e.g. "ACT-849201"
  activationToken String   @unique // URL token
  claimedUserId  String?
  claimedAt      DateTime?
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedReason  String?
  renewalCount   Int       @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  group          Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  claimedUser    User?     @relation("ClaimedUser", fields: [claimedUserId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([ownerId])
  @@index([status])
  @@index([activationCode])
  @@index([activationToken])
  @@index([expiresAt])
}

model DigitalContract {
  id                    String                   @id @default(cuid())
  contractCode          String                   @unique // e.g. "HD-2026-8921"
  groupId               String
  title                 String
  templateType          String                   // RENTAL, EDUCATION, SPORTS, GENERAL
  status                String                   @default("DRAFT") // DRAFT, PENDING_PARTY_B, READY_TO_SIGN, PARTIALLY_SIGNED, COMPLETED, EXPIRED, CANCELLED
  version               Int                      @default(1)
  ownerId               String                   // Party A
  memberId              String?                  // Party B Member ID
  partyBUserId          String?                  // Party B User ID
  partyBName            String
  partyBPhone           String?
  partyBIdCard          String?                  // CCCD / ID Card
  partyBAddress         String?
  effectiveDate         DateTime?                @db.Date
  expirationDate        DateTime?                @db.Date
  contentHtml           String                   // Formatted contract body
  contentHash           String?                  // SHA-256 integrity hash
  fieldsJson            String?                  // Dynamic placeholder key-values
  partyARequiredFields  String?                  // JSON array
  partyBRequiredFields  String?                  // JSON array
  partyBCompletedFields Boolean                  @default(false)
  docxUrl               String?                  // Exported DOCX path
  pdfUrl                String?                  // Exported PDF path
  signatureLevel        String                   @default("LEVEL_2_ESIGN") // LEVEL_1_CONFIRMATION, LEVEL_2_ESIGN, LEVEL_3_DIGITAL_CERT
  isCompleted           Boolean                  @default(false)
  completedAt           DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  group                 Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  signatures            ContractSignature[]
  versions              ContractVersionHistory[]

  @@index([groupId])
  @@index([ownerId])
  @@index([memberId])
  @@index([partyBUserId])
  @@index([status])
  @@index([contractCode])
}

model ContractSignature {
  id                 String          @id @default(cuid())
  contractId         String
  signerType         String          // PARTY_A, PARTY_B, GUARDIAN
  signerId           String          // User ID
  signerName         String
  signerRole         String
  signatureType      String          @default("DRAWING") // DRAWING, TYPING, OTP_CONFIRMED, CA_CERTIFICATE
  signatureData      String?         // Base64 PNG signature or Cert ID
  ipAddress          String?
  userAgent          String?
  signedContentHash  String          // SHA-256 hash at signing time
  signedAt           DateTime        @default(now())
  caProvider         String?         // VNPT, Viettel, FPT
  caCertSerial       String?

  contract           DigitalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([signerId])
  @@index([signerType])
}

model ContractVersionHistory {
  id              String          @id @default(cuid())
  contractId      String
  version         Int
  changedById     String
  changedByName   String
  changeSummary   String
  snapshotContent String
  createdAt       DateTime        @default(now())

  contract        DigitalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([version])
}

model SpaceClause {
  id                     String                   @id @default(cuid())
  groupId                String
  clauseType             String                   // RENTAL_RULES, TUITION_POLICY, SPORTS_REGULATION, GENERAL_TERMS
  title                  String
  version                Int                      @default(1)
  content                String
  previousContent        String?
  changeReason           String?
  effectiveDate          DateTime                 @default(now())
  isActive               Boolean                  @default(true)
  requiresReacceptance   Boolean                  @default(false)
  createdById            String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  group                  Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  acceptances            SpaceClauseAcceptance[]

  @@index([groupId])
  @@index([clauseType])
  @@index([isActive])
}

model SpaceClauseAcceptance {
  id              String      @id @default(cuid())
  clauseId        String
  groupId         String
  userId          String
  userName        String
  versionAccepted Int
  ipAddress       String?
  acceptedAt      DateTime    @default(now())

  clause          SpaceClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@unique([clauseId, userId, versionAccepted])
  @@index([clauseId])
  @@index([groupId])
  @@index([userId])
}

model PricingHistory {
  id            String   @id @default(cuid())
  groupId       String
  itemType      String   // DEFAULT_FEE, SERVICE, SURCHARGE, METER_RATE
  itemId        String?
  itemName      String
  oldPrice      Int
  newPrice      Int
  currency      String   @default("VND")
  effectiveFrom DateTime @default(now())
  reason        String
  changedById   String
  changedByName String
  createdAt     DateTime @default(now())

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([itemType])
  @@index([effectiveFrom])
}

model DocumentOcrJob {
  id              String   @id @default(cuid())
  groupId         String
  userId          String
  fileName        String
  fileUrl         String
  fileType        String   // image/jpeg, image/png, application/pdf
  status          String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  rawText         String?
  extractedFields String?  // JSON string
  confidenceScore Float?
  templateMapped  String?  // RENTAL_CONTRACT, EDUCATION_AGREEMENT, etc.
  errorMessage    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([status])
}

model SurchargeProposal {
  id              String    @id @default(cuid())
  groupId         String
  memberId        String
  title           String    // e.g. "Phí vệ sinh đột xuất", "Bồi hoàn thiết bị"
  category        String    // PRE_AGREED, NEW_INCIDENTAL, INDEMNITY_VIOLATION
  amount          Int       // VND integer
  reason          String
  evidenceUrl     String?
  clauseReference String?
  status          String    @default("PROPOSED") // DRAFT, PROPOSED, WAITING_FOR_PARTY_B, ACCEPTED, REJECTED, DISPUTED, CANCELLED
  proposedById    String
  proposedByName  String
  responseNote    String?
  respondedAt     DateTime?
  invoicedAt      DateTime?
  invoiceId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  group           Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([memberId])
  @@index([status])
  @@index([category])
}


